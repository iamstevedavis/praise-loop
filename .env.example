# --- Postgres (Compose service) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=effective_memory

# --- Database URL ---
# Used by host execution (web/worker on the host, database in containers):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/effective_memory
# Compose services (migrate/web/worker) build their own URL from POSTGRES_*
# and connect via the service name (e.g. ...@postgres:5432/...) — this
# variable does not need to change for all-container runs.

# --- Redis ---
# Durable BullMQ generation delivery; localhost:6379 for host execution.
REDIS_URL=redis://localhost:6379

# --- AI (optional) ---
# Enables caption generation and the draft pipeline. When unset, caption
# generation fails with an actionable per-draft error (drafts are marked
# `failed`) instead of crashing the worker.
OPENAI_API_KEY=

# Milliseconds before the caption provider call is aborted (default: 20000).
OPENAI_TIMEOUT_MS=20000

# --- Worker ---
# Milliseconds between draft-generation sweeps (default: 60000).
DRAFT_PIPELINE_INTERVAL_MS=60000

# --- Generated media ---
# Where rendered draft images are written and served from. Defaults to
# private-media (the generated_media volume mount point in Compose).
MEDIA_ROOT=

# Owner sign-in: Google OAuth web client (openid/email/profile only); see docs/auth.md.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OWNER_GENERATION_DAILY_LIMIT=25

# --- Mobile app gate (public, owner-free) ---
# Installed apps below MOBILE_MINIMUM_VERSION show an "update required" screen.
# Features is a comma-separated list of flag names; defaults are 1.0.0 / none.
MOBILE_MINIMUM_VERSION=1.0.0
MOBILE_LATEST_VERSION=1.0.0
MOBILE_FEATURES=
